# ==============================================================================
# Android Release Signing Credentials (Template)
# Copy this file to .env and configure your values.
# ==============================================================================

# Base64-encoded keystore content (Recommended for CI/CD)
# Generate with: base64 -w 0 path/to/upload.keystore
ANDROID_KEYSTORE_BASE64=""

# Keystore password
ANDROID_KEYSTORE_PASSWORD=""

# Key alias (default: upload)
ANDROID_KEY_ALIAS="upload"

# Key password (optional, defaults to ANDROID_KEYSTORE_PASSWORD)
ANDROID_KEY_PASSWORD=""

# Optional: Direct path to local keystore file
ANDROID_KEYSTORE_PATH=".local/android-upload.keystore"
